object cpd extends MillPluginModule with MillPluginMutation {
  def artifactName = "mill-cpd_mill1"

  // First released in 1.0.0, so that is the baseline rather than the repo-wide 0.3.0.
  override def mimaPreviousVersions = Seq("1.0.0")

  // The one module StringLiteral can run on: CpdSupport.scala has a single os.Path literal segment, so its lone
  // `Task.dest / ""` mutant is the only macro-expansion rollback the run needs. A second such literal (or an
  // `os.exists` for MethodExpression to turn into `os.forall`) exhausts the single retry: drop this override then.
  override def strykerExcludedMutations = Seq.empty

  def strykerTestModule = test

  object test    extends MillPluginTests {
    // The unit tests drive UnitTester over the example workspace.
    def resources = Task.Sources(example.moduleDir / "resources")
  }
  object example extends MillPluginExampleTests {
    def pluginModules = Seq(cpd)
  }
}
