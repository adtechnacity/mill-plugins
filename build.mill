// No MillPluginMutation: the tests read MILL_TEST_RESOURCE_DIR, which the 0.9.0 stryker runner does not forward
// (it ignores the test module's forkEnv), so the initial test run fails before any mutant is tried.
object cpd extends MillPluginModule {
  def artifactName = "mill-cpd_mill1"

  // Not released yet: nothing to compare against until the first version ships.
  override def mimaPreviousArtifacts = Task(Seq.empty[Dep])

  object test    extends MillPluginTests {
    // The unit tests drive UnitTester over the example workspace.
    def resources = Task.Sources(example.moduleDir / "resources")
  }
  object example extends MillPluginExampleTests {
    def pluginModules = Seq(cpd)
  }
}
