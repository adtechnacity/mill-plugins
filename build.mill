package build

import mill._, scalalib._, publish._
import mill.contrib.versionfile.VersionFileModule
import com.github.lolgab.mill.mima.*
import mill.contrib.scoverage.{ScoverageModule, ScoverageReport}
import atn.mill.*

val millVersion = mill.util.BuildInfo.millVersion

object projectVersion extends VersionFileModule {
  def moduleDir = build.moduleDir
}

trait MillPluginModule extends ScalaModule with PublishModule with Mima with ScoverageModule {
  def scalaVersion         = "3.8.4"
  def scoverageVersion     = "2.5.2"
  def publishVersion       = projectVersion.currentVersion().toString
  def mimaPreviousVersions = Seq("0.3.0")

  def pomSettings = PomSettings(
    description = artifactName(),
    organization = "com.adtechnacity",
    url = "https://github.com/adtechnacity/mill-plugins",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("adtechnacity", "mill-plugins"),
    developers = Seq(Developer("adtechnacity", "Adtechnacity", "https://github.com/adtechnacity"))
  )

  def compileMvnDeps = super.compileMvnDeps() ++ Seq(mvn"com.lihaoyi::mill-libs:$millVersion")

  // ScoverageTests runs the suite against the instrumented classes, so `__.test` collects coverage.
  trait MillPluginTests extends ScoverageTests {
    def mvnDeps       = Seq(
      mvn"com.lihaoyi::utest:0.9.5",
      mvn"com.lihaoyi::mill-testkit:$millVersion",
      mvn"com.lihaoyi::mill-libs:$millVersion",
      mvn"org.scalacheck::scalacheck:1.19.0"
    )
    def testFramework = "utest.runner.Framework"
  }

  trait MillPluginExampleTests extends ScalaTests {
    def pluginModules: Seq[PublishModule]

    def mvnDeps       = Seq(mvn"com.lihaoyi::utest:0.9.5", mvn"com.lihaoyi::mill-testkit:$millVersion")
    def testFramework = "utest.runner.Framework"

    def pluginArtifacts: T[Seq[(mill.scalalib.publish.Artifact, os.Path, os.Path)]] = Task {
      Task.traverse(pluginModules) { m =>
        Task.Anon {
          (m.artifactMetadata(), m.jar().path, m.pom().path)
        }
      }()
    }

    def localM2Repo: T[PathRef] = Task {
      import java.nio.file.{Files, StandardCopyOption}
      val repo = Task.dest / "m2repo"
      for ((art, jar, pom) <- pluginArtifacts()) {
        val base = repo / os.RelPath(art.group.replace('.', '/')) / art.id / art.version
        os.makeDir.all(base)
        Files.copy(jar.toNIO, (base / s"${art.id}-${art.version}.jar").toNIO, StandardCopyOption.REPLACE_EXISTING)
        Files.copy(pom.toNIO, (base / s"${art.id}-${art.version}.pom").toNIO, StandardCopyOption.REPLACE_EXISTING)
      }
      PathRef(repo)
    }

    def forkEnv = Task {
      val repo      = localM2Repo().path
      val existing  = Task.env.getOrElse("COURSIER_REPOSITORIES", "ivy2Local|central")
      Map(
        "MILL_EXECUTABLE_PATH"  -> (build.moduleDir / "mill").toString,
        "COURSIER_REPOSITORIES" -> s"${repo.toNIO.toUri.toASCIIString}|$existing",
        "PLUGIN_VERSION"        -> projectVersion.currentVersion().toString
      )
    }
  }
}

/** Mutation testing of a plugin module with the published mill-stryker4s: `./mill <module>.strykerMutate`. */
trait MillPluginMutation extends Stryker4sModule {
  def strykerVersion = "0.20.4"

  // Two mutators produce mutants that os-lib rejects at compile time: MethodExpression turns `os.exists(p)` into
  // `os.forall(p)` (no such member) and StringLiteral turns `dir / "name"` into `dir / ""` (the path-segment macro
  // fails on an empty literal). The 0.9.0 runner reports one generic compile error instead of per-line ones, so
  // stryker4s cannot roll back just those mutants and aborts the whole module (UnableToFixCompilerErrorsException).
  // Both patterns occur in nearly every plugin, so the mutators are excluded rather than the files.
  override def strykerExcludedMutations = Seq("MethodExpression", "StringLiteral")
}

/** Aggregated coverage over every plugin module: `./mill scoverage.htmlReportAll` / `scoverage.xmlReportAll`. */
object scoverage extends ScoverageReport {
  def scalaVersion     = "3.8.4"
  def scoverageVersion = "2.5.2"
}

object core extends MillPluginModule {
  def artifactName = "mill-core_mill1"
  def mvnDeps      = Seq(mvn"com.lihaoyi::upickle:4.4.3", mvn"org.eclipse.jgit:org.eclipse.jgit:7.7.1.202607240634-r")
}

object stryker4s extends MillPluginModule with MillPluginMutation {
  def artifactName = "mill-stryker4s_mill1"
  def moduleDeps   = Seq(core)
  def mvnDeps      = Seq(
    mvn"io.stryker-mutator::stryker4s-core:0.20.4",
    mvn"io.stryker-mutator::stryker4s-command-runner:0.20.4",
    mvn"co.fs2::fs2-core:3.13.0"
  )

  def strykerTestModule = test

  object test    extends MillPluginTests
  object example extends MillPluginExampleTests {
    def pluginModules = Seq(core, stryker4s)
  }

  // The coverage-based runner rewrite replaced the per-mutation process runner
  // (MillTestRunner, StrykerTestRunnerMain) with the upstream sbt-testrunner;
  // those classes were implementation detail of the plugin, not user API.
  override def mimaBinaryIssueFilters =
    super.mimaBinaryIssueFilters() ++ Seq(
      ProblemFilter.exclude[MissingTypesProblem]("atn.mill.Stryker4sReport"),
      ProblemFilter.exclude[MissingClassProblem]("atn.mill.MillTestRunner*"),
      ProblemFilter.exclude[MissingClassProblem]("atn.mill.StrykerTestRunnerMain*"),
      ProblemFilter.exclude[DirectMissingMethodProblem]("atn.mill.Stryker4sMillRunner.this"),
      ProblemFilter.exclude[Problem]("atn.mill.Stryker4sMillRunner.<init>$default$9"),
      // MillProcessTestRunner is the runner's process plumbing (only Stryker4sMillRunner calls newProcess); its
      // signature grew the forwarded test-module environment.
      ProblemFilter.exclude[DirectMissingMethodProblem]("atn.mill.MillProcessTestRunner.newProcess")
    )

}

object scalafix extends MillPluginModule {
  def artifactName = "mill-scalafix_mill1"
  def mvnDeps      = Seq(mvn"com.goyeau::mill-scalafix_mill1:0.6.2", mvn"ch.epfl.scala:scalafix-interfaces:0.14.7")

  object example extends MillPluginExampleTests {
    def pluginModules = Seq(scalafix)
  }
}

object docs extends MillPluginModule with MillPluginMutation {
  def artifactName = "mill-docs_mill1"
  def mvnDeps      = Seq(mvn"org.typelevel::cats-core:2.13.0", mvn"com.lihaoyi::mill-contrib-scoverage:$millVersion")

  // docRootModule became a ModuleRef[Module] instead of a bare Module so that Mill's resolver no longer
  // reflects it as a child module (`docs.docRootModule`, which breaks `__` selectors), and the
  // moduleDirectChildren override that papered over the traversal loop went with it. This is a deliberate
  // breaking change: consumers must now write `def docRootModule = ModuleRef(build)`.
  override def mimaBinaryIssueFilters =
    super.mimaBinaryIssueFilters() ++ Seq(
      ProblemFilter.exclude[IncompatibleResultTypeProblem]("atn.mill.DocsModule.docRootModule"),
      ProblemFilter.exclude[ReversedMissingMethodProblem]("atn.mill.DocsModule.docRootModule"),
      ProblemFilter.exclude[DirectMissingMethodProblem]("atn.mill.DocsModule.moduleDirectChildren")
    )

  def strykerTestModule = test

  object test    extends MillPluginTests
  object example extends MillPluginExampleTests {
    def pluginModules = Seq(docs)
  }
}

object githooks extends MillPluginModule with MillPluginMutation {
  def artifactName = "mill-githooks_mill1"
  def moduleDeps   = Seq(core)
  def mvnDeps      = Seq(
    mvn"org.kapunga::fallatol-ollama:0.3.1",
    mvn"org.eclipse.jgit:org.eclipse.jgit:7.7.1.202607240634-r",
    mvn"com.lihaoyi::mainargs:0.7.8"
  )

  // GitInstall is an internal helper (only GitHooksModule.install constructs it); the added
  // prePushExtraCommands param is defaulted, so the constructor change is source-compatible.
  override def mimaBinaryIssueFilters =
    super.mimaBinaryIssueFilters() ++ Seq(ProblemFilter.exclude[DirectMissingMethodProblem]("atn.mill.GitInstall.this"))

  def strykerTestModule = test

  object test    extends MillPluginTests
  object example extends MillPluginExampleTests {
    def pluginModules = Seq(core, githooks)
  }
}

