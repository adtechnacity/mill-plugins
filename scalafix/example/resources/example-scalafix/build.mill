package build

import mill._, scalalib._
import atn.mill._

// Local scalafix rule module. Scala 2.13 because scalafix loads rules via a 2.13 classloader.
object rule extends ScalaModule {
  def scalaVersion = "2.13.16"
  def mvnDeps      = Seq(mvn"ch.epfl.scala::scalafix-core:0.14.6")
}

// Application module to be linted. Mix in ScalafixSupport and point at the local rule via scalafixToolModules.
object app extends ScalaModule with ScalafixSupport {
  def scalaVersion        = "3.8.2"
  def scalafixToolModules = Seq(rule)
  def scalafixMvnDeps     = Seq.empty[Dep]
}

/** Usage

> ./mill rule.compile

> ./mill app.compile

> ./mill resolve app.scalafix
app.scalafix

> ./mill resolve app.scalafixCheck
app.scalafixCheck

> ./mill app.scalafixCheck

*/
