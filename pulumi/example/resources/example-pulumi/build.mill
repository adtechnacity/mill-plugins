package build

import mill._, scalalib._
import atn.mill._

// PulumiModule keeps infrastructure as Scala code compiled by Mill. It adds
// the com.pulumi Java SDK to the classpath, builds the program as an assembly
// jar, generates a Pulumi.yaml with a java runtime pointing at that jar, and
// runs operations through the Pulumi Automation API. The pulumi CLI must be
// installed; nothing else is required.
//
//   ./mill pulumi.preview               # preview against the default stack
//   ./mill pulumi.up --stack prod       # apply to a named stack
//   ./mill pulumi.refresh
//   ./mill pulumi.destroy
//
// Stack config files (Pulumi.dev.yaml, ...) live in the module directory and
// are checked in; gitignore the generated pulumi/Pulumi.yaml.
object pulumi extends PulumiModule {
  def scalaVersion = "3.8.2"

  override def pulumiStack = "dev"

  // Packages that are not in the registry: each gets a Java SDK generated
  // from its source and compiled in, plus a packages entry in Pulumi.yaml so
  // the engine loads the plugin from that same source at runtime. Relative
  // paths resolve against the workspace root.
  //
  //   override def pulumiLocalPackages = Map("acme-plugin-dep" -> "../acme-plugin-dep")
  //
  // Providers the generated SDK refers to are ordinary dependencies:
  //
  //   override def mvnDeps = super.mvnDeps() ++ Seq(mvn"com.pulumi:aws:7.11.0")
}

/**
 * Usage
 *
 * > ./mill resolve pulumi._ ...destroy... ...preview... ...refresh... ...up...
 */
